<?xml version="1.0"?>
<robot name="brazo_robot_actividad5">
  <material name="gris"><color rgba="0.25 0.25 0.28 1"/></material>
  <material name="azul"><color rgba="0.1 0.65 0.9 1"/></material>
  <material name="naranja"><color rgba="0.95 0.55 0.12 1"/></material>
  <material name="rojo"><color rgba="0.9 0.15 0.2 1"/></material>

  <link name="base_link">
    <visual><geometry><cylinder length="0.12" radius="0.12"/></geometry><material name="gris"/></visual>
  </link>

  <link name="brazo_1">
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><cylinder length="0.24" radius="0.04"/></geometry>
      <material name="azul"/>
    </visual>
  </link>

  <joint name="joint_base" type="revolute">
    <parent link="base_link"/><child link="brazo_1"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <link name="brazo_2">
    <visual>
      <origin xyz="0 0 0.11"/>
      <geometry><cylinder length="0.22" radius="0.035"/></geometry>
      <material name="naranja"/>
    </visual>
  </link>

  <joint name="joint_brazo" type="revolute">
    <parent link="brazo_1"/><child link="brazo_2"/>
    <origin xyz="0 0 0.24"/><axis xyz="0 1 0"/>
    <limit lower="-1.3" upper="1.3" effort="10" velocity="1"/>
  </joint>

  <link name="pinza">
    <visual>
      <origin xyz="0 0 0.045"/>
      <geometry><box size="0.10 0.035 0.09"/></geometry>
      <material name="rojo"/>
    </visual>
  </link>

  <joint name="joint_pinza" type="revolute">
    <parent link="brazo_2"/><child link="pinza"/>
    <origin xyz="0 0 0.22"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="1.2" effort="5" velocity="1"/>
  </joint>
</robot>